# Every registry call in the recordings goes to the private test registry on
# this laptop (Verdaccio or equivalent). Never the public registry.
registry=http://localhost:4873/

# Session C: npm 11.15 install sources. Remote tarball URLs are refused until
# someone passes --allow-remote on purpose. Confirm the key name against npm
# 11.15 at recording time (PRD F3 builder notes).
allow-remote=none
