{
  "name": "web-unleashed-2026",
  "version": "0.1.0",
  "private": true,
  "description": "Presenter app for \"2026 advances in the web\", FITC Web Unleashed 2026",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "node --conditions=react-server --import tsx scripts/validate.mts",
    "validate": "pnpm typecheck && pnpm lint && pnpm check --strict",
    "walk": "node --conditions=react-server --import tsx scripts/walk-demos.mts",
    "meters": "node --conditions=react-server --import tsx scripts/meters.mts",
    "extract:demos": "tsx scripts/extract-demo-prd.mts"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-jsx-runtime": "2.3.6",
    "linkedom": "0.18.12",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "prettier": "3.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
