{
  "name": "web-unleashed-2026",
  "version": "0.1.0",
  "private": true,
  "description": "Presenter app for \"2026 advances in the web\", FITC Web Unleashed 2026",
  "scripts": {
    "predev": "pnpm -s theme:sync",
    "dev": "next dev",
    "prebuild": "pnpm -s theme:sync",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "node --conditions=react-server --import tsx scripts/validate.mts",
    "axe": "node --conditions=react-server --import tsx scripts/axe-frames.mts",
    "test:contrast": "node --import tsx scripts/contrast-test.mts",
    "test:support": "node --conditions=react-server --import tsx scripts/support-test.mts",
    "test:settle": "node --import tsx scripts/settle-test.mts",
    "test:validator": "node --conditions=react-server --import tsx scripts/validator-fixtures.mts",
    "validate": "pnpm typecheck && pnpm lint && pnpm meters && pnpm test && pnpm check",
    "test": "pnpm -s test:validator && pnpm -s test:support && pnpm -s test:contrast && pnpm -s test:settle",
    "walk": "node --conditions=react-server --import tsx scripts/walk-demos.mts",
    "support": "node --conditions=react-server --import tsx scripts/support-data.mts",
    "excerpt": "node --import tsx scripts/excerpt.mts",
    "visuals": "node --conditions=react-server --import tsx scripts/visuals.mts",
    "theme:sync": "node --import tsx scripts/theme.mts sync",
    "theme:lint": "node --import tsx scripts/theme.mts lint",
    "measure:vite": "node --import tsx scripts/measure-vite.mts",
    "capture": "node --import tsx scripts/capture.mts",
    "meters": "node --conditions=react-server --import tsx scripts/meters.mts",
    "dev:framework": "pnpm -s theme:sync && pnpm --dir demos/06-framework-cache dev",
    "build:framework": "pnpm -s theme:sync && pnpm --dir demos/06-framework-cache build",
    "start:framework": "pnpm -s theme:sync && pnpm --dir demos/06-framework-cache start",
    "dev:framework-today": "pnpm -s theme:sync && pnpm --dir demos/06-framework-cache-today dev",
    "build:framework-today": "pnpm -s theme:sync && pnpm --dir demos/06-framework-cache-today build",
    "start:framework-today": "pnpm -s theme:sync && pnpm --dir demos/06-framework-cache-today start"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-jsx-runtime": "2.3.6",
    "linkedom": "0.18.12",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.31",
    "prettier": "3.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "web-features": "3.44.0"
  }
}
