{
  "printWidth": 100,
  "singleQuote": false,
  "overrides": [
    {
      "files": [
        "content/demos/**/*.{html,css,js}"
      ],
      "options": {
        "printWidth": 56
      }
    },
    {
      "files": [
        "demos/*/today/**/*.{html,css,js}"
      ],
      "options": {
        "printWidth": 44
      }
    },
    {
      "files": [
        "demos/06-framework-cache-today/app/products/**/*.tsx",
        "demos/06-framework-cache-today/lib/{catalog,inventory}.ts"
      ],
      "options": {
        "printWidth": 44
      }
    }
  ]
}
